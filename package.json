{
  "name": "paincy-3d",
  "version": "1.0.0",
  "private": true,
  "description": "Паинцы 3D · Молочные войны",
  "author": "Паинцы 3D",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "build:desktop": "npm run build && tsc -p electron/tsconfig.json",
    "build:win": "npm run build:desktop && node electron/prepare-installer.mjs && electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "@dimforge/rapier3d-compat": "^0.19.0",
    "three": "^0.180.0",
    "@types/three": "^0.180.0",
    "electron": "45.5.0",
    "electron-builder": "26.18.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0"
  },
  "build": {
    "appId": "games.paincy.milkwars",
    "productName": "Паинцы 3D",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "dist-electron/main.cjs"],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "icon": "build/icon.ico",
      "executableName": "Paincy3D",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "script": "dist-electron/installer.nsi",
      "artifactName": "Paincy3D-Setup.exe",
      "installerLanguages": ["ru_RU"],
      "deleteAppDataOnUninstall": false
    },
    "portable": { "artifactName": "Paincy3D-Portable.exe" }
  }
}
